{
  "name": "vitely",
  "version": "1.6.0",
  "description": "Vitely, starter vite project with goodies",
  "keywords": [
    "atomic-design",
    "boilerplate",
    "ddd",
    "ddd-example",
    "typescript",
    "unocss",
    "vite",
    "vue",
    "vue-boilerplate"
  ],
  "license": "MIT",
  "author": "Rubiin",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && vue-tsc --noEmit",
    "preview": "vite preview",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:e2e": "cypress open",
    "test:unit": "vitest",
    "start": "serve dist -l 4000",
    "stylelint": "stylelint --config stylelintrc.json 'src/**/*.vue'",
    "stylelint:fix": "stylelint --config stylelintrc.json --fix 'src/**/*.vue'",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@iconify-json/bx": "^1.2.3",
    "@iconify-json/carbon": "^1.2.28",
    "@intlify/unplugin-vue-i18n": "^11.2.5",
    "@rollup/plugin-strip": "^3.0.4",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/vue3": "^10.6.1",
    "@storybook/vue3-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^26.6.4",
    "@unocss/preset-icons": "^66.10.5",
    "@unocss/preset-typography": "^66.10.5",
    "@unocss/preset-uno": "^66.10.5",
    "@unocss/transformer-directives": "^66.10.5",
    "@unocss/transformer-variant-group": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "cypress": "^16.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss-html": "^2.0.0",
    "sass": "^1.105.1",
    "serve": "^14.2.6",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "typescript": "^6.0.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-fonts": "^2.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "lint-staged": {
    "*.{js,ts,jsx,tsx,vue}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,scss,yaml,yml}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    "last 2 version",
    "> 0.2%"
  ],
  "engines": {
    "node": ">=24",
    "pnpm": ">=12.8.1"
  }
}
